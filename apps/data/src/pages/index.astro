---
// 问卷页（分步）：题目与选项来自 shared schema，结构见 docs/specs/survey.md
import {
  ACCOUNT_SOURCE,
  ACCOUNT_STATUS,
  ACCOUNTS_IN_ENV,
  CARD_KIND,
  CHAT_LANGUAGE,
  CLIENT,
  CN_CLIENT,
  DISTILL,
  EMAIL_TYPE,
  ENV_BAN_HISTORY,
  EXIT_TYPE,
  JAILBREAK,
  LOGIN_METHOD,
  NODE_SWITCH,
  OS,
  PAYMENT_METHOD,
  PHONE_VERIFY,
  PLAN,
  PROXY_MODE,
  REFUND,
  REVERSE_PROXY,
  SENSITIVE_USE,
  SHARING,
  SYSTEM_LANGUAGE,
  TEXT_LIMITS,
  TIMEZONE_SETTING,
  USAGE_CAP,
} from '@claude-analysis/shared';
import BanQuestions from '../components/survey/BanQuestions.astro';
import DateSelect from '../components/survey/DateSelect.astro';
import Question from '../components/survey/Question.astro';
import RegionSelect from '../components/survey/RegionSelect.astro';
import Base from '../layouts/Base.astro';
import { DETECT_URL } from '../lib/sites';
import '../styles/survey.css';

const STEPS = ['账号状态', '账号来历', '网络环境', '使用习惯', '确认提交'];
const num = (i: number) => String(i + 1).padStart(2, '0');

const ENV_SAME = { same: '一致', different: '不一致' };
const ENV_SOURCE = { detect: '用检测站自动获取', manual: '手动填写' };
const GP_VIA = { ...CARD_KIND, other: '其他' };
---

<Base title="Claude 使用情况调查问卷 · claude-analysis" description="匿名问卷：收集不同使用环境下 Claude 账号的封禁情况。不收集邮箱、账号和任何 IP。" current="survey">
  <section class="hero survey-hero">
    <h1>Claude 使用情况调查问卷</h1>
    <p>一份问卷对应一个 Claude 账号，分 5 步，大约 3 分钟。匿名填写，不收集邮箱、账号和任何 IP。账号正常也欢迎填，以后被封了可以回来更新。</p>
    <p class="survey-count" id="count" hidden>已收集 <span class="mono" id="count-num"></span> 份问卷</p>
  </section>

  <section class="card panel saved" id="saved" hidden>
    <h2 class="card__title">你在这个浏览器提交过的问卷</h2>
    <p class="card__desc">管理链接记在这个浏览器里，点开可以更新账号状态或删除问卷。用的是别人的电脑的话，记得移除。</p>
    <ul class="saved__list" id="saved-list"></ul>
  </section>

  <form class="survey" id="survey" novalidate>
    <ol class="steps" aria-label="问卷进度">
      {
        STEPS.map((name, i) => (
          <li>
            <button class="steps__item" type="button" data-goto={i} disabled={i > 0}>
              <span class="steps__num">{num(i)}</span>
              <span class="steps__name">{name}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <section class="card panel step" data-step="0" data-active>
      <h2 class="card__title"><span class="card__num">01</span>账号状态</h2>
      <div class="qs">
        <Question id="status" num="A1" label="这个账号现在的状态" options={ACCOUNT_STATUS} />
        <Question id="registeredAt" num="A2" label="注册时间" hint="买来或别人共享的账号不知道，可以勾「不清楚」">
          <DateSelect id="registeredAt" unknown />
        </Question>
        <BanQuestions />
      </div>
    </section>

    <section class="card panel step" data-step="1">
      <h2 class="card__title"><span class="card__num">02</span>账号来历</h2>
      <div class="qs">
        <Question id="source" num="C1" label="账号来源" options={ACCOUNT_SOURCE} />
        <Question id="login" num="C2" label="登录方式" options={LOGIN_METHOD} />
        <Question id="emailType" num="C3" label="邮箱类型" options={EMAIL_TYPE} hidden>
          <div class="sub" data-sub="emailDomain" hidden>
            <Question id="emailDomain" label="邮箱后缀" optional hint="只填 @ 后面的部分">
              <span class="affix">
                <span class="affix__pre">@</span>
                <input class="input" name="emailDomain" placeholder="example.com" maxlength={TEXT_LIMITS.emailDomain} autocomplete="off" spellcheck="false" />
              </span>
            </Question>
          </div>
        </Question>
        <Question id="phone" num="C4" label="注册时手机号怎么验证的" options={PHONE_VERIFY} />
        <Question id="plan" num="C5" label="订阅" options={PLAN} />
        <Question id="payment" num="C6" label="付款方式" options={PAYMENT_METHOD} hidden>
          <div class="sub" data-sub="card" hidden>
            <Question id="cardKind" label="卡类型" options={CARD_KIND} />
            <Question id="cardBin" label="卡号前 6 位" optional hint="只能看出发卡行和卡种，看不出是谁的卡">
              <input class="input input--bin" name="cardBin" inputmode="numeric" maxlength="6" placeholder="6 位数字" autocomplete="off" />
            </Question>
            <Question id="cardRegion" label="发卡地区" optional hint="不想填卡号，可以只填这个">
              <RegionSelect name="cardRegion" label="发卡地区" />
            </Question>
          </div>
          <div class="sub" data-sub="app_store" hidden>
            <Question id="appStoreRegion" label="Apple ID 所在区">
              <RegionSelect name="appStoreRegion" label="Apple ID 所在区" />
            </Question>
          </div>
          <div class="sub" data-sub="google_play" hidden>
            <Question id="gpVia" label="实际付款方式" options={GP_VIA} />
            <Question id="gpBin" label="卡号前 6 位" optional hint="只能看出发卡行和卡种，看不出是谁的卡" hidden>
              <input class="input input--bin" name="gpBin" inputmode="numeric" maxlength="6" placeholder="6 位数字" autocomplete="off" />
            </Question>
            <Question id="gpRegion" label="发卡地区" optional hint="不想填卡号，可以只填这个" hidden>
              <RegionSelect name="gpRegion" label="发卡地区" />
            </Question>
            <Question id="gpNote" label="具体方式" optional hidden>
              <input class="input" name="gpNote" maxlength={TEXT_LIMITS.paymentNote} placeholder="例如 PayPal、礼品卡" autocomplete="off" />
            </Question>
          </div>
        </Question>
        <Question id="refund" num="C7" label="被封后退款情况" options={REFUND} hidden />
        <Question id="accountsInEnv" num="C8" label="同一网络或设备下有几个 Claude 账号" hint="包括这个账号" options={ACCOUNTS_IN_ENV} />
        <Question id="envBanHistory" num="C9" label="同一设备或网络下，有没有别的账号被封过" options={ENV_BAN_HISTORY} />
      </div>
    </section>

    <section class="card panel step" data-step="2">
      <h2 class="card__title"><span class="card__num">03</span>网络环境</h2>
      <p class="card__desc">检测站能带入出口、IP 属性、环境指纹和泄露情况，比自己填准确。</p>
      <div class="qs">
        <Question
          id="envSame"
          num="D1"
          label="你现在的设备和网络，和这个账号平时用的一致吗"
          hint="被封的账号，和被封时用的比。不一致只能手动填写。"
          options={ENV_SAME}
        />
        <Question
          id="exitType"
          num="D2"
          label="代理情况"
          hint="这个账号平时通过什么方式连 Claude，被封的账号按被封时的填。检测站看不出 IP 是从哪来的，所以都要问。"
          options={EXIT_TYPE}
        />
        <Question id="envSource" num="D3" label="其他网络环境怎么填" options={ENV_SOURCE} hidden />

        <div class="sub detect" data-sub="detect" hidden>
          <ol class="detect__steps">
            <li>
              <span>在新标签页打开检测站，等检测完成。</span>
              <a class="btn" href={DETECT_URL} target="_blank" rel="noopener">打开检测站</a>
            </li>
            <li>点检测站上的「复制结果码」，回到这里粘贴。</li>
          </ol>
          <div class="detect__privacy">
            <p class="detect__privacy-title">关于隐私</p>
            <ul>
              <li>结果码只含检测结论（出口国家、网络类型、风险标记、时区、语言等），不含任何 IP。</li>
              <li>问卷站不读取、也不保存你的 IP。</li>
              <li>检测站上，你的国内 IP 只在你的浏览器里显示，不会发给任何服务器；Claude 出口 IP 只用来向 IP 数据库查询属性，以加盐哈希缓存 24 小时，不保存原文、不记日志。</li>
            </ul>
            <p>
              <a href={`${DETECT_URL}privacy`} target="_blank" rel="noopener">检测站隐私说明</a>{' · '}<a href="/privacy" target="_blank"
                >问卷站隐私说明</a
              >
            </p>
          </div>
          <Question id="resultCode" label="结果码" hint="有效期 1 小时，从在检测站检测时算起">
            <textarea class="input textarea textarea--code" name="resultCode" rows="3" placeholder="粘贴结果码" spellcheck="false"></textarea>
          </Question>
          <div class="snap" id="snap" hidden>
            <div class="snap__head">
              <span>从检测站带入</span>
              <span class="tag" data-status="neutral" id="snap-verified"></span>
            </div>
            <div class="snap__rows" id="snap-rows"></div>
            <p class="snap__foot" id="snap-foot"></p>
          </div>
        </div>

        <div data-sub="manual" hidden>
          <p class="manual__hint">下面按这个账号平时用的环境填，被封的账号按被封时的环境填。</p>
          <Question id="exitRegion" num="M1" label="访问 Claude 时出口在哪个国家或地区">
            <RegionSelect name="exitRegion" label="出口国家或地区" unknown />
          </Question>
          <Question id="proxyMode" num="M2" label="代理模式" options={PROXY_MODE} />
          <Question id="timezone" num="M3" label="系统时区" options={TIMEZONE_SETTING} />
          <Question id="language" num="M4" label="系统和浏览器语言" options={SYSTEM_LANGUAGE} />
          <Question id="nodeSwitch" num="M5" label="节点会不会自动切换" options={NODE_SWITCH} />
          <Question
            id="cnClient"
            num="M6"
            label="有没有在国产手机或国产浏览器上用过 Claude"
            hint="如华为、小米等手机，QQ、夸克、360 等浏览器，或在微信里直接打开"
            options={CN_CLIENT}
          />
        </div>
      </div>
    </section>

    <section class="card panel step" data-step="3">
      <h2 class="card__title"><span class="card__num">04</span>使用习惯</h2>
      <div class="qs">
        <Question id="clients" num="E1" label="用哪些客户端" options={CLIENT} multi />
        <Question id="os" num="E2" label="设备系统" options={OS} multi />
        <Question id="usageCap" num="E3" label="用量上限" options={USAGE_CAP} />
        <Question id="chatLanguage" num="E4" label="对话主要用什么语言" options={CHAT_LANGUAGE} />
        <Question id="sharing" num="E5" label="谁在用这个账号" options={SHARING} />
        <Question id="reverseProxy" num="E6" label="有没有用 CPA 或其他软件做逆向或反代" options={REVERSE_PROXY} multi exclusive={['none']} />
        <Question id="jailbreak" num="E7" label="有没有破限或 NSFW 使用" hint="只用于统计，选「不便回答」也没关系" options={JAILBREAK} />
        <Question id="distill" num="E8" label="有没有用 Claude 的回答训练或微调别的模型（蒸馏）" hint="只用于统计，选「不便回答」也没关系" options={DISTILL} />
        <Question id="sensitiveUse" num="E9" label="有没有这些用途" options={SENSITIVE_USE} multi exclusive={['none', 'decline']} />
      </div>
    </section>

    <section class="card panel step" data-step="4">
      <h2 class="card__title"><span class="card__num">05</span>确认提交</h2>
      <p class="card__desc">检查一下答案，要改哪一步就点「修改」。</p>
      <div class="review" id="review"></div>
      <div class="qs">
        <Question id="note" num="F1" label="还有什么想补充的" optional hint="比如被封前后的经过、你觉得可能的原因。不要写邮箱、账号等能认出你的信息。">
          <textarea class="input textarea" name="note" maxlength={TEXT_LIMITS.note} rows="4"></textarea>
          <span class="counter mono" id="note-count">0 / {TEXT_LIMITS.note}</span>
        </Question>
      </div>
    </section>

    <div class="survey__nav">
      <button class="btn" id="prev" type="button" hidden>上一步</button>
      <!-- 脚本就绪后才启用：否则会按默认方式 GET 提交，把答案带进 URL -->
      <button class="btn btn--primary" id="next" type="submit" disabled>下一步</button>
    </div>
  </form>

  <section class="card panel done" id="done" hidden>
    <h2 class="card__title">提交成功</h2>
    <p class="card__desc">谢谢！你的回答已经匿名保存。</p>
    <div class="done__body">
      <p class="done__label">管理链接</p>
      <p class="q__hint">请收藏或保存。账号状态有变化（比如被封了）用它回来更新，也可以随时删除这份问卷。</p>
      <div class="link-row">
        <input class="input mono" id="manage-link" readonly aria-label="管理链接" />
        <button class="btn" id="copy-link" type="button">复制</button>
      </div>
      <p class="q__hint" id="saved-note"></p>
    </div>
  </section>

  <div class="toast" id="toast" role="status"></div>
</Base>

<script>
  import '../scripts/survey';
</script>
