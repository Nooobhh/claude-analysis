{
  "name": "@claude-analysis/data",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "astro build && wrangler d1 migrations apply claudeban --local && wrangler dev --port 8788",
    "build": "astro build",
    "typecheck": "wrangler types && astro sync && tsc --noEmit -p worker && tsc --noEmit",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@claude-analysis/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "wrangler": "^4.144.0"
  }
}
