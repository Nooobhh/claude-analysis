{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-analysis",
  "main": "worker/index.ts",
  // 本地 workerd 支持到 2026-09-26，不能晚于它
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // /api/ip 限频：查自己的出口放宽，查别的 IP 收紧（period 只能是 10 或 60 秒）
  "ratelimits": [
    { "name": "RL_SELF", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_OTHER", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ],
  // IP 属性缓存，key 为加盐哈希，TTL 24h
  "kv_namespaces": [{ "binding": "IP_CACHE", "id": "354540a4885e4fc2ad1b2c48a76e34b9" }],
  // 隐私：不开日志 / 追踪
  "observability": { "enabled": false }
}
