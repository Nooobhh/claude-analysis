---
import { STATUS_LABEL } from '@claude-analysis/shared';
import CheckCard from '../components/CheckCard.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { COMMIT, VERSION } from '../lib/build-info';
import {
  AVAIL_CHECKS,
  CHECKS,
  CROSS_CHECKS,
  EXIT_CHECKS,
  EXIT_ROWS,
  FP_CHECKS,
  IP_ATTRS,
  IP_RISKS,
  anchorOf,
  type CheckDef,
} from '../lib/catalog';

const STATS = ['bad', 'warn', 'ok', 'unknown'] as const;
/** 分区导航（Header），id 与下方各分区一致 */
const NAV = [
  ['ip', 'IP 信息'],
  ['exits', '出口'],
  ['leaks', '泄露'],
  ['avail', '可用性'],
  ['env', '环境'],
] as const;
const FIELD_GROUPS: Array<[title: string, checks: CheckDef[]]> = [
  ['属性', IP_ATTRS],
  ['风险标记 · proxycheck.io 与 ipapi.is 同时查询', IP_RISKS],
];
---

<Base
  title="Claude 使用环境检测 · claude-analysis"
  description="检测访问 Claude 时的出口 IP、IP 风险、环境指纹与 WebRTC / DNS 泄露。开源、本地检测、不存数据。"
>
  <nav slot="header-nav" class="sectnav" aria-label="页面分区">
    {NAV.map(([id, name]) => <a href={`#${id}`}>{name}</a>)}
  </nav>
  <button slot="header-actions" class="switch" id="toggle-ip" type="button" role="switch" aria-checked="true">
    <span class="switch__track" aria-hidden="true"></span>显示 IP
  </button>

  <section class="hero">
    <h1>Claude 使用环境检测</h1>
    <p>检查你访问 Claude 时的出口 IP、IP 风险、环境指纹和泄露情况。检测在浏览器里完成，国内 IP 不会离开你的设备。</p>
  </section>

  <div class="card summary">
    <div class="summary__progress" id="progress"></div>
    <div class="summary__top">
      <div class="stats">
        {
          STATS.map((s) => (
            <div class="stat" data-status={s} data-zero="true" hidden={s === 'unknown'}>
              <span class="stat__num" data-count={s}>
                0
              </span>
              <span class="stat__label">{STATUS_LABEL[s]}</span>
            </div>
          ))
        }
      </div>
      <div class="summary__side">
        <span class="summary__label" id="progress-label">检测中 0/{CHECKS.length}</span>
        <div class="summary__actions">
          <button class="btn" id="rerun" type="button">重新检测</button>
          <button class="btn btn--primary" id="copy-code" type="button" data-version={VERSION} data-commit={COMMIT}>复制结果码</button>
        </div>
      </div>
    </div>
    <div class="verdicts" id="verdicts" hidden>
      {
        [
          ['network', '网络环境'],
          ['fingerprint', '设备指纹'],
        ].map(([kind, name]) => (
          <div class="verdict" data-kind={kind}>
            <span class="verdict__name">{name}</span>
            <span class="tag" data-status="unknown">无法判断</span>
          </div>
        ))
      }
    </div>
    <div class="issues" id="issues" hidden>
      <h2 class="issues__title">发现的问题</h2>
      <div class="issues__list" id="issues-list"></div>
      <p class="issues__empty" id="issues-empty" hidden>没有发现异常或需要注意的项。</p>
    </div>
    <p class="sr-only" id="announce" aria-live="polite"></p>
  </div>

  <Section
    id="ip"
    title="IP 信息"
    icon="globe"
    desc="Claude 看到的出口 IP 及其属性与风险标记。只有这个 IP 会发给本站查询，结果缓存 24 小时；两家数据库结论不同时并排显示。"
  >
    <div class="card ipcard">
      <div class="ipcard__head">
        <div>
          <span class="ipcard__label">Claude 出口 IP</span>
          <div class="ipcard__ip">
            <span class="ipcard__value" id="hero-ip"><span class="skeleton"></span></span>
            <button class="icon-btn" id="copy-ip" type="button" aria-label="复制 IP" title="复制 IP" hidden>
              <Icon name="copy" />
            </button>
          </div>
        </div>
        <span class="ipcard__note" id="hero-note">检测中</span>
      </div>
      {
        FIELD_GROUPS.map(([title, checks]) => (
          <div class="ipcard__group">
            <h3 class="ipcard__group-title">{title}</h3>
            <div class="fields">
              {checks.map((check) => (
                <div class="field" data-check={check.id} id={anchorOf(check.id)}>
                  <span class="field__label">
                    {check.icon && <Icon name={check.icon} />}
                    {check.label}
                  </span>
                  <div class="field__body">
                    <span class="check__value">
                      <span class="skeleton" />
                    </span>
                    <span class="tag" data-status="pending">
                      检测中
                    </span>
                  </div>
                  <p class="check__reason" hidden />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    id="exits"
    title="出口一览"
    icon="route"
    desc="流量离开你设备的每条通道。正常情况下 Claude 各通道应是同一个境外 IP，WebRTC 与 DNS 不应落在国内。"
  >
    <div class="card xcard">
      <div class="xtable" role="table" aria-label="出口一览">
        <div class="xrow xrow--head" role="row">
          <span role="columnheader">通道</span>
          <span role="columnheader">出口 IP</span>
          <span role="columnheader">地区 / 说明</span>
          <span role="columnheader">状态</span>
        </div>
        {
          EXIT_ROWS.map((row) => (
            <div class="xrow check" data-check={row.id} id={anchorOf(row.id)} role="row">
              <div class="xrow__channel" role="cell">
                <span class="check__name">{row.label}</span>
                {row.hint && <span class="check__hint">{row.hint}</span>}
              </div>
              <div class="xrow__ip check__value" role="cell">
                <span class="skeleton" />
              </div>
              <p class="xrow__note check__reason" role="cell" hidden />
              <div class="xrow__status" role="cell">
                <span class="tag" data-status="pending">
                  检测中
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="minis">
      {EXIT_CHECKS.map((check) => <CheckCard check={check} />)}
    </div>
  </Section>

  <Section
    id="leaks"
    title="泄露检测"
    icon="droplet"
    desc="WebRTC 走 UDP、DNS 查询走系统解析器，都可能绕过代理暴露真实网络。每个 STUN 服务器、每个 DNS 解析器各一张卡。"
    rerun="leaks"
  >
    <div class="minis">
      <div class="minis__group" data-leak="leak.webrtc"></div>
      <div class="minis__group" data-leak="leak.dns"></div>
    </div>
  </Section>

  <Section id="avail" title="可用性" icon="activity" desc="到 Anthropic 的延迟与官方服务状态。" rerun="avail">
    <div class="minis">
      {AVAIL_CHECKS.map((check) => <CheckCard check={check} />)}
    </div>
  </Section>

  <Section id="env" title="环境指纹" icon="monitor" desc="网页能读到的系统特征，全部在本地计算。">
    <div class="minis">
      {FP_CHECKS.map((check) => <CheckCard check={check} />)}
    </div>
    <h3 class="sect__sub">交叉比对<span> · 单项正常、放在一起互相矛盾的组合</span></h3>
    <div class="minis">
      {CROSS_CHECKS.map((check) => <CheckCard check={check} />)}
    </div>
  </Section>

  <div class="toast" id="toast" role="status"></div>
</Base>

<script>
  import '../scripts/detect';
</script>
