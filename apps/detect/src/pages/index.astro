---
import { ENV_PASS_SCORE, FINGERPRINT_WARN, NETWORK_WARN, STATUS_LABEL } from '@claude-analysis/shared';
import Base from '../layouts/Base.astro';
import { COMMIT, VERSION } from '../lib/build-info';
import { CARDS, CHECKS, EXIT_ROWS, anchorOf } from '../lib/catalog';
import { SURVEY_URL } from '../lib/sites';

const STATS = ['bad', 'warn', 'ok', 'unknown'] as const;
const num = (i: number) => String(i).padStart(2, '0');
/** 扣分规则全文，与问卷站看板共用 shared scoring.ts */
const rules = (warn: typeof NETWORK_WARN) =>
  Object.values(warn)
    .map(([label, points]) => `${label} −${points}`)
    .join(' · ');
---

<Base
  title="Claude 使用环境检测 · claude-analysis"
  description="检测访问 Claude 时的出口 IP、IP 风险、环境指纹与 WebRTC / DNS 泄露。开源、本地检测、不存数据。"
  current="home"
>
  <button slot="header-actions" class="switch" id="toggle-ip" type="button" role="switch" aria-checked="false">
    <span class="switch__track" aria-hidden="true"></span>显示 IP
  </button>

  <section class="hero">
    <h1>Claude 使用环境检测</h1>
    <p>检查你访问 Claude 时的出口 IP、IP 风险、环境指纹和泄露情况。检测在浏览器里完成，国内 IP 不会离开你的设备。</p>
  </section>

  <div class="card summary">
    <div class="summary__progress" id="progress"></div>
    <div class="summary__top">
      <div class="stats">
        {
          STATS.map((s) => (
            <div class="stat" data-status={s} data-zero="true" hidden={s === 'unknown'}>
              <span class="stat__num" data-count={s}>
                0
              </span>
              <span class="stat__label">{STATUS_LABEL[s]}</span>
            </div>
          ))
        }
      </div>
      <div class="summary__side">
        <span class="summary__label" id="progress-label">检测中 0/{CHECKS.length}</span>
        <div class="summary__actions">
          <button class="btn" id="rerun" type="button">重新检测</button>
          <button class="btn" id="copy-code" type="button" data-version={VERSION} data-commit={COMMIT}>复制结果码</button>
          <button class="btn btn--primary" id="copy" type="button">复制报告</button>
        </div>
      </div>
    </div>
    <p class="summary__note">
      结果码用于填写 <a href={SURVEY_URL} target="_blank" rel="noopener">Claude 使用情况调查问卷</a>：只含检测结论，不含任何 IP；在浏览器里生成后复制，不会发送任何数据。
    </p>
    <div class="verdicts" id="verdicts" hidden>
      {
        [
          ['network', '网络环境'],
          ['fingerprint', '设备指纹'],
        ].map(([kind, name]) => (
          <div class="verdict" data-kind={kind}>
            <span class="verdict__name">{name}</span>
            <span class="tag" data-status="unknown">无法判断</span>
            <span class="verdict__detail" />
          </div>
        ))
      }
      <details class="verdict__rules">
        <summary>怎么判定</summary>
        <p>满分 100，扣到 {ENV_PASS_SCORE} 分以下不通过；页面只显示通过与否和扣了哪些分，不显示分数。</p>
        <p>网络环境：任何一项「异常」直接不通过；「注意」扣分：{rules(NETWORK_WARN)}。</p>
        <p>设备指纹：「注意」扣分：{rules(FINGERPRINT_WARN)}。</p>
        <p>权重是初始值，等收集到足够的封号数据再校准。</p>
      </details>
    </div>
    <div class="issues" id="issues" hidden>
      <h2 class="issues__title">发现的问题</h2>
      <div class="issues__list" id="issues-list"></div>
      <p class="issues__empty" id="issues-empty" hidden>没有发现异常或需要注意的项。</p>
    </div>
    <p class="sr-only" id="announce" aria-live="polite"></p>
  </div>

  <section class="card panel panel--table" aria-labelledby="card-exits">
    <h2 class="card__title" id="card-exits"><span class="card__num">01</span>出口一览</h2>
    <p class="card__desc">流量离开你设备的每条通道。正常情况下 Claude 各通道应是同一个境外 IP，WebRTC 与 DNS 不应落在国内。</p>
    <div class="xtable" role="table" aria-labelledby="card-exits">
      <div class="xrow xrow--head" role="row">
        <span role="columnheader">通道</span>
        <span role="columnheader">出口 IP</span>
        <span role="columnheader">地区 / 说明</span>
        <span role="columnheader">状态</span>
      </div>
      {
        EXIT_ROWS.map((row) => (
          <div class="xrow check" data-check={row.id} id={anchorOf(row.id)} role="row">
            <div class="xrow__channel" role="cell">
              <span class="check__name">{row.label}</span>
              {row.hint && <span class="check__hint">{row.hint}</span>}
            </div>
            <div class="xrow__ip check__value" role="cell">
              <span class="skeleton" />
            </div>
            <p class="xrow__note check__reason" role="cell" hidden />
            <div class="xrow__status" role="cell">
              <span class="tag" data-status="pending">
                检测中
              </span>
            </div>
            <details class="details xrow__details" hidden>
              <summary />
              <dl />
            </details>
          </div>
        ))
      }
    </div>
  </section>

  <div class="grid">
    {
      CARDS.map((card, i) => (
        <section class:list={['card', 'panel', { 'panel--wide': card.wide }]} aria-labelledby={`card-${card.id}`}>
          <h2 class="card__title" id={`card-${card.id}`}>
            <span class="card__num">{num(i + 2)}</span>
            {card.title}
          </h2>
          {card.desc && <p class="card__desc">{card.desc}</p>}
          <div class="panel__rows">
            {card.checks.map((check) => (
              <div class="check" data-check={check.id} id={anchorOf(check.id)}>
                <div class="check__main">
                  <div class="check__label">
                    <span class="check__name">{check.label}</span>
                    {check.hint && <span class="check__hint">{check.hint}</span>}
                  </div>
                  <div class="check__right">
                    <span class="check__value">
                      <span class="skeleton" />
                    </span>
                    <span class="tag" data-status="pending">
                      检测中
                    </span>
                  </div>
                </div>
                <p class="check__reason" hidden />
                <details class="details" hidden>
                  <summary />
                  <dl />
                </details>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <div class="toast" id="toast" role="status"></div>
</Base>

<script>
  import '../scripts/detect';
</script>
